{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.1" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Cost-Aware Multi-Agent Orchestration — System Overview",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Total requests",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          },
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(gateway_tier_distribution_total)",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Token usage",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          },
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(gateway_tokens_used_total)",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Budget utilization",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "mappings": [],
          "unit": "percent",
          "decimals": 1,
          "max": 100,
          "min": 0,
          "noValue": "0%"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg(gateway_budget_usage_percent)",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 4,
      "type": "piechart",
      "title": "1. Request distribution by tier",
      "description": "Shows how the routing strategy distributes requests across the three tiers.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 10 },
      "options": {
        "pieType": "donut",
        "displayLabels": [],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "values": ["percent"]
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ECONOMY" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#37872D", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "FALLBACK" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#E05F00", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "PRIMARY" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#1F60C4", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(gateway_tier_distribution_total) by (tier)",
          "legendFormat": "{{tier}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 5,
      "type": "timeseries",
      "title": "2. Token consumption over time",
      "description": "Shows whether token consumption is increasing steadily or approaching the budget limit.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 10 },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "fillOpacity": 15,
        "gradientMode": "none",
        "lineWidth": 2,
        "pointSize": 5,
        "showPoints": "auto",
        "spanNulls": false
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "none",
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "tokens/min",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(gateway_tokens_used_total[2m])) * 120",
          "legendFormat": "Tokens / 2 min",
          "instant": false,
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 6,
      "type": "gauge",
      "title": "3. Budget utilization",
      "description": "A clear indicator of the current budget consumption. Max budget = 10,000 tokens per agent.",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 5 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 7000 },
              { "color": "red", "value": 9000 }
            ]
          },
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": 10000,
          "displayName": "Used budget",
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(gateway_tokens_used_total)",
          "legendFormat": "Used budget",
          "instant": true,
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 7,
      "type": "barchart",
      "title": "4. Average response latency by tier",
      "description": "Illustrates the latency difference between tiers (PRIMARY < ECONOMY < FALLBACK).",
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 10 },
      "options": {
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "fillOpacity": 80,
        "gradientMode": "none",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "orientation": "auto",
        "showValue": "auto",
        "stacking": "none",
        "tooltip": { "mode": "single", "sort": "none" },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#1F60C4", "mode": "fixed" },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineWidth": 1
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "ms",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(gateway_invoke_duration_seconds_sum) by (tier) / sum(gateway_invoke_duration_seconds_count) by (tier) * 1000",
          "legendFormat": "{{tier}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": { "valueLabel": "tier" }
        }
      ]
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "6. Predicted vs actual token consumption",
      "description": "Demonstrates Predictive Token Costing (PTC) and prediction accuracy. Blue = predicted (p50), Green = actual average per request.",
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 10 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "fillOpacity": 15,
        "gradientMode": "none",
        "lineWidth": 2,
        "pointSize": 6,
        "showPoints": "always",
        "spanNulls": false
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "none",
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "tokens",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "stepAfter",
            "pointSize": 6,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "always",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Predicted avg" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#1F60C4", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Actual avg/req" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#37872D", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "gateway_predicted_tokens_summary_tokens_sum / gateway_predicted_tokens_summary_tokens_count",
          "legendFormat": "Predicted avg",
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(gateway_tokens_used_total) / sum(gateway_tier_distribution_total)",
          "legendFormat": "Actual avg/req",
          "instant": false,
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 9,
      "type": "stat",
      "title": "5. Shared token pool",
      "description": "Demonstrates Dynamic Budget Sharing (DBS). Available = current pool, Donated = total donated, Borrowed = total borrowed.",
      "gridPos": { "x": 0, "y": 29, "w": 24, "h": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          },
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "gateway_pool_size_tokens",
          "legendFormat": "Available",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(gateway_pool_donated_tokens_total)",
          "legendFormat": "Donated",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(gateway_pool_borrowed_tokens_total)",
          "legendFormat": "Borrowed",
          "instant": true,
          "refId": "C"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }

  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["opaca", "cost-gateway"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Cost-Aware Multi-Agent Orchestration",
  "uid": "opaca-cost-gateway",
  "version": 2,
  "weekStart": ""
}
